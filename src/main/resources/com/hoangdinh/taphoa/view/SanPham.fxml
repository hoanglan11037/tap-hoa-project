<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root" styleClass="page"
      fx:controller="com.hoangdinh.taphoa.controller.SanPhamController">

    <HBox styleClass="page-head">
        <VBox>
            <Label styleClass="eyebrow" text="KHO HÀNG"/>
            <HBox spacing="10" alignment="BASELINE_LEFT">
                <Label styleClass="page-title" text="Sản phẩm"/>
                <Label fx:id="lblTong" styleClass="page-count"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="btn-outline" text="Xuất CSV" onAction="#onExport">
            <graphic><FontIcon iconLiteral="mdi2d-download"/></graphic>
        </Button>
        <Button fx:id="btnThem" styleClass="btn-primary" text="Thêm sản phẩm" onAction="#onNew">
            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
        </Button>
    </HBox>

    <HBox styleClass="filter-bar">
        <HBox styleClass="search" prefWidth="300">
            <FontIcon iconLiteral="mdi2m-magnify"/>
            <TextField fx:id="txtSearch" promptText="Tên, mã SP hoặc mã vạch" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ComboBox fx:id="cbDanhMuc" prefWidth="180" promptText="Mọi danh mục"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox styleClass="segmented">
            <ToggleButton fx:id="fAll" text="Tất cả" selected="true">
                <toggleGroup><ToggleGroup fx:id="filterGroup"/></toggleGroup>
            </ToggleButton>
            <ToggleButton fx:id="fCon" text="Còn hàng" toggleGroup="$filterGroup" userData="CON_HANG"/>
            <ToggleButton fx:id="fSap" text="Sắp hết" toggleGroup="$filterGroup" userData="SAP_HET"/>
            <ToggleButton fx:id="fHet" text="Hết hàng" toggleGroup="$filterGroup" userData="HET_HANG"/>
            <ToggleButton fx:id="fNgung" text="Ngừng bán" toggleGroup="$filterGroup" userData="NGUNG_BAN"/>
        </HBox>
    </HBox>

    <TableView fx:id="table" styleClass="grid" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMa" text="Mã" prefWidth="80" minWidth="76"/>
            <TableColumn fx:id="colTen" text="Sản phẩm" prefWidth="280"/>
            <TableColumn fx:id="colDm" text="Danh mục" prefWidth="120"/>
            <TableColumn fx:id="colGiaBan" text="Giá bán" prefWidth="110"/>
            <TableColumn fx:id="colGiaNhap" text="Giá nhập" prefWidth="110"/>
            <TableColumn fx:id="colTon" text="Tồn kho" prefWidth="150"/>
            <TableColumn fx:id="colTt" text="Tình trạng" prefWidth="120"/>
            <TableColumn fx:id="colAct" text="" prefWidth="56" minWidth="56" maxWidth="56" sortable="false"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="Không có sản phẩm phù hợp"/></placeholder>
    </TableView>

    <HBox styleClass="pager">
        <Label fx:id="lblPage" styleClass="muted" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="lblHint" styleClass="muted" text="Nháy đúp vào dòng để sửa"/>
        <Button fx:id="btnPrev" styleClass="icon-btn" onAction="#onPrev">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-left"/></graphic>
        </Button>
        <Label fx:id="lblPageNo" styleClass="page-no"/>
        <Button fx:id="btnNext" styleClass="icon-btn" onAction="#onNext">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-right"/></graphic>
        </Button>
    </HBox>
</VBox>
