<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root" styleClass="page"
      fx:controller="com.hoangdinh.taphoa.controller.HoaDonController">

    <HBox styleClass="page-head">
        <VBox>
            <Label styleClass="eyebrow" text="BÁN HÀNG"/>
            <Label styleClass="page-title" text="Hóa đơn"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="btn-outline" text="Xuất CSV" onAction="#onExport">
            <graphic><FontIcon iconLiteral="mdi2d-download"/></graphic>
        </Button>
    </HBox>

    <HBox styleClass="filter-bar">
        <HBox styleClass="search" prefWidth="300">
            <FontIcon iconLiteral="mdi2m-magnify"/>
            <TextField fx:id="txtSearch" promptText="Số hóa đơn, tên hoặc SĐT khách" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox styleClass="segmented">
            <ToggleButton fx:id="rHomNay" text="Hôm nay" userData="0">
                <toggleGroup><ToggleGroup fx:id="rangeGroup"/></toggleGroup>
            </ToggleButton>
            <ToggleButton text="7 ngày" toggleGroup="$rangeGroup" userData="6"/>
            <ToggleButton text="30 ngày" toggleGroup="$rangeGroup" userData="29"/>
        </HBox>
        <Label styleClass="muted" text="Từ"/>
        <DatePicker fx:id="dpTu" prefWidth="140"/>
        <Label styleClass="muted" text="đến"/>
        <DatePicker fx:id="dpDen" prefWidth="140"/>
    </HBox>

    <HBox styleClass="summary-strip">
        <VBox HBox.hgrow="ALWAYS"><Label styleClass="sum-label" text="Số hóa đơn"/><Label fx:id="sumSo" styleClass="sum-value"/></VBox>
        <VBox HBox.hgrow="ALWAYS"><Label styleClass="sum-label" text="Thực thu"/><Label fx:id="sumThu" styleClass="sum-value, text-green"/></VBox>
        <VBox HBox.hgrow="ALWAYS"><Label styleClass="sum-label" text="Giảm giá"/><Label fx:id="sumGiam" styleClass="sum-value"/></VBox>
        <VBox HBox.hgrow="ALWAYS"><Label styleClass="sum-label" text="Đã hủy"/><Label fx:id="sumHuy" styleClass="sum-value, text-red"/></VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="grid" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSo" text="Số HĐ" prefWidth="100"/>
                <TableColumn fx:id="colNgay" text="Thời gian" prefWidth="130"/>
                <TableColumn fx:id="colKhach" text="Khách hàng" prefWidth="170"/>
                <TableColumn fx:id="colPt" text="Hình thức" prefWidth="110"/>
                <TableColumn fx:id="colTien" text="Thanh toán" prefWidth="120"/>
                <TableColumn fx:id="colTt" text="Trạng thái" prefWidth="120"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label text="Không có hóa đơn trong khoảng thời gian này"/></placeholder>
        </TableView>

        <VBox styleClass="side-panel" minWidth="360" maxWidth="360">
            <StackPane VBox.vgrow="ALWAYS">
                <ScrollPane fx:id="receiptScroll" fitToWidth="true" styleClass="receipt-scroll" managed="false" visible="false">
                    <StackPane fx:id="receiptHost" styleClass="receipt-host"/>
                </ScrollPane>
                <VBox fx:id="noSelection" styleClass="empty-state">
                    <FontIcon iconLiteral="mdi2r-receipt"/>
                    <Label styleClass="empty-title" text="Chọn một hóa đơn"/>
                    <Label styleClass="muted" text="Chi tiết phiếu tính tiền sẽ hiện ở đây"/>
                </VBox>
            </StackPane>
            <HBox fx:id="actions" styleClass="panel-actions" managed="false" visible="false">
                <Button fx:id="btnHuy" styleClass="btn-danger-outline" text="Hủy hóa đơn" onAction="#onHuy">
                    <graphic><FontIcon iconLiteral="mdi2c-cancel"/></graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="btn-primary" text="In lại" onAction="#onIn">
                    <graphic><FontIcon iconLiteral="mdi2p-printer"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>
