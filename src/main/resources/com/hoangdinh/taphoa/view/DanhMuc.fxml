<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root" styleClass="page"
      fx:controller="com.hoangdinh.taphoa.controller.DanhMucController">

    <HBox styleClass="page-head">
        <VBox>
            <Label styleClass="eyebrow" text="KHO HÀNG"/>
            <HBox spacing="10" alignment="BASELINE_LEFT">
                <Label styleClass="page-title" text="Danh mục"/>
                <Label fx:id="lblTong" styleClass="page-count"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="btn-primary" text="Thêm danh mục" onAction="#onNew">
            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
        </Button>
    </HBox>

    <Label styleClass="muted" text="Mỗi thẻ là một nhóm hàng: số sản phẩm và giá trị hàng tồn tính theo giá nhập."/>

    <ScrollPane fitToWidth="true" styleClass="page-scroll" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cards" styleClass="card-grid"/>
    </ScrollPane>
</VBox>
