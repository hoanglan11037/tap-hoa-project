<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root" styleClass="page"
      fx:controller="com.hoangdinh.taphoa.controller.NhaCungCapController">

    <HBox styleClass="page-head">
        <VBox>
            <Label styleClass="eyebrow" text="ĐỐI TÁC"/>
            <HBox spacing="10" alignment="BASELINE_LEFT">
                <Label styleClass="page-title" text="Nhà cung cấp"/>
                <Label fx:id="lblTong" styleClass="page-count"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="btn-primary" text="Thêm nhà cung cấp" onAction="#onNew">
            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
        </Button>
    </HBox>

    <HBox styleClass="filter-bar">
        <HBox styleClass="search" prefWidth="320">
            <FontIcon iconLiteral="mdi2m-magnify"/>
            <TextField fx:id="txtSearch" promptText="Tên, người liên hệ, số điện thoại" HBox.hgrow="ALWAYS"/>
        </HBox>
        <CheckBox fx:id="chkDangHopTac" text="Chỉ hiện đang hợp tác"/>
    </HBox>

    <TableView fx:id="table" styleClass="grid" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTen" text="Nhà cung cấp" prefWidth="260"/>
            <TableColumn fx:id="colLienHe" text="Liên hệ" prefWidth="170"/>
            <TableColumn fx:id="colDiaChi" text="Địa chỉ" prefWidth="230"/>
            <TableColumn fx:id="colNhap" text="Lần nhập gần nhất" prefWidth="160"/>
            <TableColumn fx:id="colTt" text="Trạng thái" prefWidth="130"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="Không có nhà cung cấp phù hợp"/></placeholder>
    </TableView>
    <Label styleClass="muted" text="Nháy đúp vào dòng để sửa thông tin."/>
</VBox>
