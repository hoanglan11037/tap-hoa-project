<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root" styleClass="page"
      fx:controller="com.hoangdinh.taphoa.controller.TaiKhoanController">
    <HBox styleClass="page-head">
        <VBox>
            <Label styleClass="eyebrow" text="HỆ THỐNG"/>
            <HBox spacing="10" alignment="BASELINE_LEFT">
                <Label styleClass="page-title" text="Nhân viên"/>
                <Label fx:id="lblTong" styleClass="page-count"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="btn-primary" text="Thêm nhân viên" onAction="#onNew">
            <graphic><FontIcon iconLiteral="mdi2a-account-plus-outline"/></graphic>
        </Button>
    </HBox>

    <HBox styleClass="info-banner">
        <FontIcon iconLiteral="mdi2i-information-outline"/>
        <Label wrapText="true" HBox.hgrow="ALWAYS"
               text="Thu ngân dùng được: bán hàng, hóa đơn, xem sản phẩm, nhập hàng, khách hàng. Chủ cửa hàng dùng thêm: sửa sản phẩm, danh mục, nhà cung cấp, báo cáo, nhân viên và hủy hóa đơn."/>
    </HBox>

    <TableView fx:id="table" styleClass="grid" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTen" text="Nhân viên" prefWidth="280"/>
            <TableColumn fx:id="colVaiTro" text="Vai trò" prefWidth="160"/>
            <TableColumn fx:id="colNgay" text="Ngày tạo" prefWidth="160"/>
            <TableColumn fx:id="colTt" text="Trạng thái" prefWidth="140"/>
            <TableColumn fx:id="colAct" text="" prefWidth="56" minWidth="56" maxWidth="56" sortable="false"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>
</VBox>
