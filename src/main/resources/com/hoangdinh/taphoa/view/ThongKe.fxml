<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root"
            fitToWidth="true" styleClass="page-scroll" fx:controller="com.hoangdinh.taphoa.controller.ThongKeController">
    <VBox styleClass="page">
        <HBox styleClass="page-head">
            <VBox>
                <Label styleClass="eyebrow" text="BÁO CÁO"/>
                <Label styleClass="page-title" text="Doanh thu &amp; lợi nhuận"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="muted" text="Năm"/>
            <ComboBox fx:id="cbNam" prefWidth="110"/>
        </HBox>

        <HBox spacing="14">
            <HBox styleClass="stat" HBox.hgrow="ALWAYS">
                <StackPane styleClass="stat-icon, tone-green"><FontIcon iconLiteral="mdi2c-cash-multiple"/></StackPane>
                <VBox><Label styleClass="stat-label" text="Doanh thu"/><Label fx:id="kpiDoanhThu" styleClass="stat-value" text="–"/></VBox>
            </HBox>
            <HBox styleClass="stat" HBox.hgrow="ALWAYS">
                <StackPane styleClass="stat-icon, tone-violet"><FontIcon iconLiteral="mdi2t-trending-up"/></StackPane>
                <VBox><Label styleClass="stat-label" text="Lãi gộp"/><Label fx:id="kpiLai" styleClass="stat-value" text="–"/>
                    <Label fx:id="kpiBien" styleClass="stat-note"/></VBox>
            </HBox>
            <HBox styleClass="stat" HBox.hgrow="ALWAYS">
                <StackPane styleClass="stat-icon, tone-blue"><FontIcon iconLiteral="mdi2r-receipt"/></StackPane>
                <VBox><Label styleClass="stat-label" text="Số hóa đơn"/><Label fx:id="kpiHd" styleClass="stat-value" text="–"/>
                    <Label fx:id="kpiTb" styleClass="stat-note"/></VBox>
            </HBox>
            <HBox styleClass="stat" HBox.hgrow="ALWAYS">
                <StackPane styleClass="stat-icon, tone-amber"><FontIcon iconLiteral="mdi2c-calendar-today"/></StackPane>
                <VBox><Label styleClass="stat-label" text="Tháng tốt nhất"/><Label fx:id="kpiMax" styleClass="stat-value" text="–"/>
                    <Label fx:id="kpiMaxNote" styleClass="stat-note"/></VBox>
            </HBox>
        </HBox>

        <HBox spacing="14">
            <VBox styleClass="panel" HBox.hgrow="ALWAYS">
                <HBox styleClass="panel-head">
                    <Label styleClass="panel-title" text="Theo tháng (triệu đồng)"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="legend" text="Doanh thu">
                        <graphic><Region styleClass="swatch, swatch-revenue"/></graphic>
                    </Label>
                    <Label styleClass="legend" text="Lãi gộp">
                        <graphic><Region styleClass="swatch, swatch-profit"/></graphic>
                    </Label>
                </HBox>
                <BarChart fx:id="chart" legendVisible="false" animated="false" prefHeight="300" barGap="3" categoryGap="16">
                    <xAxis><CategoryAxis tickMarkVisible="false"/></xAxis>
                    <yAxis><NumberAxis minorTickVisible="false" tickMarkVisible="false"/></yAxis>
                </BarChart>
            </VBox>
            <VBox styleClass="panel" prefWidth="380" minWidth="360">
                <HBox styleClass="panel-head">
                    <Label styleClass="panel-title" text="Top 10 bán chạy cả năm"/>
                </HBox>
                <VBox fx:id="listTop" spacing="2"/>
            </VBox>
        </HBox>

        <VBox styleClass="panel">
            <Label styleClass="panel-title" text="Chi tiết từng tháng"/>
            <TableView fx:id="table" styleClass="grid" prefHeight="440">
                <columns>
                    <TableColumn fx:id="colThang" text="Tháng" prefWidth="100"/>
                    <TableColumn fx:id="colHd" text="Hóa đơn" prefWidth="100"/>
                    <TableColumn fx:id="colDt" text="Doanh thu" prefWidth="160"/>
                    <TableColumn fx:id="colLai" text="Lãi gộp" prefWidth="160"/>
                    <TableColumn fx:id="colBien" text="Biên lãi" prefWidth="100"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
