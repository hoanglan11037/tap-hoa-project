<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/app.css" fx:id="root" styleClass="page"
      fx:controller="com.hoangdinh.taphoa.controller.NhapHangController">

    <HBox styleClass="page-head">
        <VBox>
            <Label styleClass="eyebrow" text="KHO HÀNG"/>
            <Label styleClass="page-title" text="Nhập hàng"/>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Lập phiếu nhập -->
        <VBox styleClass="panel" HBox.hgrow="ALWAYS">
            <HBox styleClass="panel-head">
                <StackPane styleClass="stat-icon, tone-teal"><FontIcon iconLiteral="mdi2p-package-down"/></StackPane>
                <VBox>
                    <Label styleClass="panel-title" text="Lập phiếu nhập"/>
                    <Label styleClass="muted" text="Lưu phiếu sẽ cộng tồn kho và cập nhật giá nhập mới"/>
                </VBox>
            </HBox>

            <VBox styleClass="field">
                <Label styleClass="field-label" text="Nhà cung cấp *"/>
                <ComboBox fx:id="cbNcc" maxWidth="Infinity" promptText="Chọn nhà cung cấp"/>
            </VBox>

            <HBox styleClass="add-line">
                <VBox styleClass="field" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Sản phẩm"/>
                    <ComboBox fx:id="cbSanPham" maxWidth="Infinity" promptText="Chọn sản phẩm"/>
                </VBox>
                <VBox styleClass="field" prefWidth="90">
                    <Label styleClass="field-label" text="Số lượng"/>
                    <TextField fx:id="txtSoLuong" promptText="0"/>
                </VBox>
                <VBox styleClass="field" prefWidth="130">
                    <Label styleClass="field-label" text="Đơn giá nhập"/>
                    <TextField fx:id="txtDonGia" promptText="0"/>
                </VBox>
                <Button styleClass="btn-outline" text="Thêm dòng" onAction="#onThemDong">
                    <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
                </Button>
            </HBox>

            <TableView fx:id="tblDong" styleClass="grid" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSp" text="Sản phẩm" prefWidth="240"/>
                    <TableColumn fx:id="colSl" text="SL" prefWidth="70"/>
                    <TableColumn fx:id="colGia" text="Đơn giá" prefWidth="110"/>
                    <TableColumn fx:id="colTien" text="Thành tiền" prefWidth="120"/>
                    <TableColumn fx:id="colXoa" text="" prefWidth="50" minWidth="50" maxWidth="50" sortable="false"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="Chưa có dòng hàng nào"/></placeholder>
            </TableView>

            <HBox styleClass="import-foot">
                <TextField fx:id="txtGhiChu" promptText="Ghi chú phiếu (không bắt buộc)" HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT">
                    <Label styleClass="sum-label" text="Tổng tiền phiếu"/>
                    <Label fx:id="lblTong" styleClass="import-total" text="0 đ"/>
                </VBox>
                <Button fx:id="btnLuu" styleClass="btn-primary" text="Lưu phiếu nhập" onAction="#onLuu">
                    <graphic><FontIcon iconLiteral="mdi2c-check"/></graphic>
                </Button>
            </HBox>
            <Label fx:id="lblError" styleClass="alert-error" maxWidth="Infinity" wrapText="true" managed="false" visible="false"/>
        </VBox>

        <!-- Lịch sử -->
        <VBox styleClass="panel" minWidth="400" maxWidth="420">
            <HBox styleClass="panel-head">
                <Label styleClass="panel-title" text="Phiếu nhập gần đây"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="muted" text="Bấm để xem chi tiết"/>
            </HBox>
            <TableView fx:id="tblPhieu" styleClass="grid" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPhieu" text="Phiếu" prefWidth="210"/>
                    <TableColumn fx:id="colPhieuTien" text="Tổng tiền" prefWidth="130"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="Chưa có phiếu nhập"/></placeholder>
            </TableView>
        </VBox>
    </HBox>
</VBox>
